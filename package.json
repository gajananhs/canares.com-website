{
  "name": "canares-com-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "description": "Canares Group corporate website (static React + Vite build)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
